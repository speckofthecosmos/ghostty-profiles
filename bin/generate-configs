#!/usr/bin/env python3
"""Generate Ghostty config-<profile> files from profiles/palette.tsv.

The table is the source. Editing a generated config gets overwritten; edit the
table and regenerate. `title` is deliberately never emitted (see docs/traps.md).

Usage: generate-configs [--out DIR]   (default: ~/.config/ghostty)
"""
import os, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FIELDS = "profile label icon badge_name badge_hex theme foreground cursor command".split()


def rows():
    with open(os.path.join(ROOT, "profiles", "palette.tsv"), encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            yield dict(zip(FIELDS, line.rstrip("\n").split("\t")))


def main():
    out = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "ghostty")
    if "--out" in sys.argv:
        out = sys.argv[sys.argv.index("--out") + 1]
    os.makedirs(out, exist_ok=True)

    shared_src = os.path.join(ROOT, "profiles", "config-shared")
    shared_dst = os.path.join(out, "config-shared")
    if not os.path.exists(shared_dst):
        with open(shared_src, encoding="utf-8") as a, open(shared_dst, "w", encoding="utf-8") as b:
            b.write(a.read())
        print(f"  config-shared     -> {shared_dst} (copied; yours now, not regenerated)")

    for r in rows():
        lines = [
            "# Generated by bin/generate-configs from profiles/palette.tsv.",
            "# Edit the table and regenerate; changes here are overwritten.",
            "",
            "config-file = config-shared",
            "",
            f"theme = {r['theme']}",
            "background = #000000",
        ]
        if r["foreground"] != "-":
            lines.append(f"foreground = {r['foreground']}")
        lines += [
            f"cursor-color = {r['cursor']}",
            "cursor-style = block",
            "",
            "# Mission Control side-stripe. Oversized in height so it never tiles.",
            f"background-image = {os.path.join(ROOT, 'badges', r['badge_name'] + '.png')}",
            "background-image-fit = none",
            "background-image-position = top-right",
            "background-image-opacity = 1.0",
            "",
            "window-decoration = none",
            "macos-titlebar-style = hidden",
            "",
        ]
        path = os.path.join(out, f"config-{r['profile']}")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
        print(f"  {r['icon']} {r['label']:<8} -> {path}")


if __name__ == "__main__":
    main()
